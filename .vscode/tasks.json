{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build malloc_test",
            "type": "shell",
            "command": "cd ${workspaceFolder}/test && gcc -g3 -O0 malloc_test.c -o malloc_test",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build-current-file",
            "type": "shell",
            "command": "mkdir -p ${workspaceFolder}/build/bin/${relativeFileDirname} && gcc -g3 -O0 -I ${workspaceFolder}/include ${file} -o ${workspaceFolder}/build/bin/${relativeFile}-debug.out",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}